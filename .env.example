# Copy to .env and adjust as needed. Everything here has a safe default for local
# development EXCEPT real LLM provider credentials, which are optional — the system
# runs fully offline (deterministic template answer synthesis) with no keys at all.

# --- Alarm Management API simulator ---
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=demo-token

# --- MCP server (spawned by the copilot backend over stdio; see docs/architecture.md) ---
MCP_SERVER_SCRIPT=mcp-servers/alarm-management/server.py

# --- LLM provider (optional) ---
# Leave LLM_PROVIDER empty to use the offline, deterministic TemplateProvider (no
# external calls, fully reproducible for grading). Set to one of: openai | anthropic |
# azure_openai to use a real model for answer synthesis (see requirements-llm.txt).
LLM_PROVIDER=
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=replace-me
AZURE_OPENAI_DEPLOYMENT=replace-me
AZURE_OPENAI_API_VERSION=2024-06-01

# --- RAG ---
DOCUMENT_PATH=rag/documents

# --- Copilot backend / GUI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8100
BACKEND_URL=http://copilot-backend:8100
